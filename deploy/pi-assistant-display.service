# systemd unit for the status board on a Pimoroni Display HAT Mini.
# scripts/install.sh --display fills in the @PLACEHOLDERS@ and installs it to
# /etc/systemd/system/pi-assistant-display.service.

[Unit]
Description=pi-assistant status board (Display HAT Mini)
After=local-fs.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_DIR@/.venv/bin/pi-assistant display
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
