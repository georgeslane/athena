# Athena's secrets. `athena setup` makes .env from this, and asks for the main ones.
# .env is git-ignored and readable only by you (chmod 600).

# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# The API key you set in oMLX. Leave empty if the server doesn't require one.
LLM_API_KEY=

# Optional: for asking by voice through Siri (see docs/using.md). Make one with: openssl rand -hex 24
SIRI_TOKEN=

# Lets iPhone Shortcuts and the like start tasks (docs/tasks.md): at least 16 characters, e.g.
# the output of `openssl rand -hex 24`. Not the dashboard's password: it can only start tasks.
TRIGGERS_TOKEN=

# The dashboard's password (see docs/dashboard.md). Athena makes one the first time it starts,
# or set your own: at least 12 characters.
DASHBOARD_TOKEN=

# Optional: a fine-grained GitHub token with only "Public repositories (read-only)" access.
GITHUB_TOKEN=

# Optional: for SEC filings. The SEC asks who's asking, as a name and email: Jane Doe jane@example.com
EDGAR_IDENTITY=

# Optional: an app password for the assistant's own email account (see docs/tools.md).
EMAIL_PASSWORD=

# Optional: a Trading 212 API key (see docs/tools.md), from Settings > API in the app.
TRADING212_API_KEY=
# ...and the secret Trading 212 showed with it.
TRADING212_API_SECRET=

# Optional: for handing coding projects to Claude (see docs/claude-projects.md). A fine-grained
# GitHub token with access to that one private repository only: Contents and Pull requests, read and write.
PROJECTS_GITHUB_TOKEN=
