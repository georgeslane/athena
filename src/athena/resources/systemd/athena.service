# systemd unit for Athena. `athena service install` fills in the @PLACEHOLDERS@ and installs it to
# /etc/systemd/system/athena.service.

[Unit]
Description=Athena, your assistant
Wants=network-online.target
After=network-online.target
# If it fails to start five times in ten minutes, systemd stops trying, and athena-stopped
# tells you in Telegram, with the end of its log. (It's started at the first failure, and waits.)
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=athena-stopped.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ATHENA_HOME@
EnvironmentFile=-@ATHENA_HOME@/.env
Environment=ATHENA_HOME=@ATHENA_HOME@
# ~/.local/bin holds uv/uvx, which local MCP servers are usually launched with.
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@ATHENA@ run
Restart=on-failure
RestartSec=10

# Hardening: if Athena, or a tool it runs, were taken over, it could change only its own folder, @ATHENA_HOME@
# (config.toml, .env and its data, which the dashboard changes), and data_dir from config.toml if that's
# elsewhere. Everything else is read-only to it: its own code, which uv installs in ~/.local/share/uv/tools,
# your home folder (~/.ssh, ~/.bashrc) and the system. Local MCP servers run in a sandbox of their own within
# this (sandbox.py), which needs user namespaces and mounts, so those stay allowed.
# tests/test_hardening.py checks all this under systemd, in CI.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@WRITABLE@
# uv's downloads and Pythons, for the MCP servers' environments, and npm's for servers started with npx...
ReadWritePaths=-@HOME@/.cache/uv -@HOME@/.local/share/uv -@HOME@/.npm
# ...but not Athena's own code, which uv keeps there too. The deeper path wins.
ReadOnlyPaths=-@HOME@/.local/share/uv/tools
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
# Not RestrictSUIDSGID=: systemd blocks openat2 for it, as it can't see the call's flags, and bubblewrap 0.12
# and later open paths with openat2 and stop if it fails. NoNewPrivileges= means setuid programs gain nothing.
ProtectKernelModules=yes
# Not ProtectKernelTunables=, ProtectKernelLogs= or ProtectHostname=: they cover parts of /proc, and then
# the sandbox can't mount a /proc of its own. Without capabilities, Athena can't change those anyway.
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
