# Secrets for pi-assistant. Copy to .env (install.sh does this) and fill in.
# .env is git-ignored and readable only by you (chmod 600).

# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# The API key you set in oMLX. Leave empty if the server doesn't require one.
LLM_API_KEY=

# Optional: for asking by voice through Siri (see README, "Siri"). Make one with: openssl rand -hex 24
SIRI_TOKEN=

# Optional: a fine-grained GitHub token with only "Public repositories (read-only)" access.
GITHUB_TOKEN=

# Optional: for SEC filings. The SEC asks who's asking, as a name and email: Jane Doe jane@example.com
EDGAR_IDENTITY=

# Optional: an app password for the assistant's own email account (see README, "Email").
EMAIL_PASSWORD=

# Optional: a Trading 212 API key (see README, "Trading 212"), from Settings > API in the app.
TRADING212_API_KEY=
# ...and the secret Trading 212 showed with it.
TRADING212_API_SECRET=
