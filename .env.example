# Secrets for pi-assistant. Copy to .env (install.sh does this) and fill in.
# .env is git-ignored and readable only by you (chmod 600).

# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# The API key you set in oMLX. Leave empty if the server doesn't require one.
LLM_API_KEY=

# Optional: token for MCP servers on the Mac, referenced in config.toml as ${MAC_MCP_TOKEN}.
MAC_MCP_TOKEN=

# Optional: for asking by voice through Siri (see README, "Siri"). Make one with: openssl rand -hex 24
SIRI_TOKEN=
